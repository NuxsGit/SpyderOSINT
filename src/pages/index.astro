---
// src/pages/index.astro
// Spyder OSINT — Page d'accueil
// Stack : Astro SSR, vanilla JS, zéro dépendance frontend
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Spyder OSINT — Moteur d'investigation numérique</title>
        <meta
            name="description"
            content="Plateforme d'investigation OSINT. Analysez emails, IPs, pseudos, Discord IDs et adresses en temps réel."
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Space+Grotesk:wght@300;400;500;600&display=swap"
            rel="stylesheet"
        />
    </head>

    <body>
        <!-- ░░ GLOW CURSEUR ░░ -->
        <div id="cursor-glow" aria-hidden="true"></div>

        <!-- ░░ GRILLE DE FOND ░░ -->
        <div class="bg-grid" aria-hidden="true"></div>

        <!-- ════════════════════════════════════════════
       NAVBAR
  ════════════════════════════════════════════ -->
        <nav class="navbar">
            <div class="nav-logo">
                <img src="/Spyder.png" alt="Logo" />
                <span class="logo-wordmark">SPYDER<em>OSINT</em></span>
            </div>

            <ul class="nav-links" role="list">
                <li><a href="#fonctionnalites">Fonctionnalités</a></li>
                <li><a href="#modules">Modules</a></li>
                <li><a href="#tarifs">Tarifs</a></li>
                <li><a href="#docs">Docs</a></li>
            </ul>

            <div class="nav-actions">
                <a href="/login" class="btn-ghost">Connexion</a>
                <a href="/register" class="btn-primary">Commencer</a>
            </div>

            <!-- Burger mobile -->
            <button
                class="burger"
                id="burger"
                aria-label="Menu"
                aria-expanded="false"
            >
                <span></span><span></span><span></span>
            </button>
        </nav>

        <!-- Mobile menu -->
        <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
            <a href="#fonctionnalites">Fonctionnalités</a>
            <a href="#modules">Modules</a>
            <a href="#tarifs">Tarifs</a>
            <a href="/login">Connexion</a>
            <a href="/register" class="btn-primary">Commencer</a>
        </div>

        <!-- ════════════════════════════════════════════
       HERO
  ════════════════════════════════════════════ -->
        <main>
            <section class="hero" aria-labelledby="hero-title">
                <div class="hero-badge">
                    <span class="badge-dot" aria-hidden="true"></span>
                    Plateforme d'investigation OSINT open-source
                </div>

                <!-- Illustration centrale araignée / toile -->
                <div class="hero-illustration" aria-hidden="true">
                    <img src="/Spyder.png" alt="Logo" class="hero-logo" />
                </div>

                <h1 id="hero-title" class="hero-title">
                    Investiguez.<br />
                    <span class="title-accent">Tout.</span> Maintenant.
                </h1>

                <p class="hero-sub">
                    Spyder OSINT détecte automatiquement le type de donnée que
                    vous saisissez et lance les modules d'investigation
                    correspondants en temps réel. Email, IP, pseudo, Discord ID,
                    adresse physique — un seul champ suffit.
                </p>

                <!-- ── Barre de recherche ── -->
                <div class="search-wrapper" role="search">
                    <div class="search-box" id="search-box">
                        <span class="search-icon" aria-hidden="true">
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 18 18"
                                fill="none"
                            >
                                <circle
                                    cx="7.5"
                                    cy="7.5"
                                    r="5.5"
                                    stroke="currentColor"
                                    stroke-width="1.6"></circle>
                                <line
                                    x1="11.5"
                                    y1="11.5"
                                    x2="16"
                                    y2="16"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"></line>
                            </svg>
                        </span>
                        <input
                            id="search-input"
                            type="text"
                            placeholder="john@gmail.com  ·  192.168.1.1  ·  @pseudo  ·  123456789012345"
                            autocomplete="off"
                            spellcheck="false"
                            aria-label="Saisir une donnée à investiguer"
                        />
                        <div
                            class="search-type-indicator"
                            id="type-indicator"
                            aria-live="polite"
                        >
                            <span id="type-label">—</span>
                        </div>
                        <button
                            class="search-btn"
                            id="search-btn"
                            aria-label="Lancer l'analyse"
                        >
                            Analyser
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 14 14"
                                fill="none"
                                aria-hidden="true"
                            >
                                <path
                                    d="M2 7h10M8 3l4 4-4 4"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path>
                            </svg>
                        </button>
                    </div>

                    <!-- Pills de type -->
                    <div
                        class="type-pills"
                        role="group"
                        aria-label="Type d'input"
                    >
                        <button class="pill" data-type="email">
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 12 12"
                                fill="none"
                                aria-hidden="true"
                            >
                                <rect
                                    x="1"
                                    y="2.5"
                                    width="10"
                                    height="7"
                                    rx="1"
                                    stroke="currentColor"
                                    stroke-width="1.2"></rect>
                                <path
                                    d="M1 4l5 3.5L11 4"
                                    stroke="currentColor"
                                    stroke-width="1.2"></path>
                            </svg>
                            Email
                        </button>
                        <button class="pill" data-type="username">
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 12 12"
                                fill="none"
                                aria-hidden="true"
                            >
                                <circle
                                    cx="6"
                                    cy="4"
                                    r="2.5"
                                    stroke="currentColor"
                                    stroke-width="1.2"></circle>
                                <path
                                    d="M1.5 10.5c0-2.5 2-4 4.5-4s4.5 1.5 4.5 4"
                                    stroke="currentColor"
                                    stroke-width="1.2"
                                    stroke-linecap="round"></path>
                            </svg>
                            Username
                        </button>
                        <button class="pill" data-type="discord_id">
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 12 12"
                                fill="none"
                                aria-hidden="true"
                            >
                                <path
                                    d="M4 2C2.5 2.5 1.5 4 1.5 6c0 2 1 3.5 2.5 4l.5-1C3 8.5 2.5 7.5 2.5 6S3 3.5 4 3l-.5-1H4z"
                                    fill="currentColor"
                                    opacity=".6"></path>
                                <path
                                    d="M8 2l-.5 1C8.5 3.5 9 4.5 9 6s-.5 2.5-1.5 3l.5 1C9.5 9.5 10.5 8 10.5 6c0-2-1-3.5-2.5-4z"
                                    fill="currentColor"
                                    opacity=".6"></path>
                                <circle
                                    cx="6"
                                    cy="6"
                                    r="1.5"
                                    fill="currentColor"></circle>
                            </svg>
                            Discord ID
                        </button>
                        <button class="pill" data-type="ip">
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 12 12"
                                fill="none"
                                aria-hidden="true"
                            >
                                <circle
                                    cx="6"
                                    cy="6"
                                    r="4.5"
                                    stroke="currentColor"
                                    stroke-width="1.2"></circle>
                                <path
                                    d="M6 1.5V6l3 1.5"
                                    stroke="currentColor"
                                    stroke-width="1.2"
                                    stroke-linecap="round"></path>
                            </svg>
                            IP
                        </button>
                        <button class="pill" data-type="phone">
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 12 12"
                                fill="none"
                                aria-hidden="true"
                            >
                                <rect
                                    x="3"
                                    y="1"
                                    width="6"
                                    height="10"
                                    rx="1"
                                    stroke="currentColor"
                                    stroke-width="1.2"></rect>
                                <circle
                                    cx="6"
                                    cy="9.5"
                                    r=".6"
                                    fill="currentColor"></circle>
                            </svg>
                            Téléphone
                        </button>
                    </div>
                </div>

                <!-- ── Stats ── -->
                <div
                    class="hero-stats"
                    aria-label="Statistiques de la plateforme"
                >
                    <div class="stat-item">
                        <span class="stat-num">+1000</span>
                        <span class="stat-label">Plateformes</span>
                    </div>
                    <div class="stat-sep" aria-hidden="true"></div>
                    <div class="stat-item">
                        <span class="stat-num">12</span>
                        <span class="stat-label">Modules actifs</span>
                    </div>
                    <div class="stat-sep" aria-hidden="true"></div>
                    <div class="stat-item">
                        <span class="stat-num">Version</span>
                        <span class="stat-label">Gratuit</span>
                    </div>
                    <div class="stat-sep" aria-hidden="true"></div>
                    <div class="stat-item">
                        <span class="stat-num">0</span>
                        <span class="stat-label">Logs stockés</span>
                    </div>
                    <div class="stat-sep" aria-hidden="true"></div>
                    <div class="stat-item">
                        <span class="stat-num">SSE</span>
                        <span class="stat-label">Résultats live</span>
                    </div>
                </div>
            </section>

            <!-- ════════════════════════════════════════════
         SECTION MODULES
    ════════════════════════════════════════════ -->
            <section
                class="modules-section"
                id="modules"
                aria-labelledby="modules-title"
            >
                <div class="section-eyebrow">// modules disponibles</div>
                <h2 id="modules-title" class="section-title">
                    Un input.<br />Cinq vecteurs d'analyse.
                </h2>

                <div class="modules-grid">
                    <article class="module-card mc-email">
                        <div class="mc-icon" aria-hidden="true">✉</div>
                        <h3 class="mc-name">Email</h3>
                        <p class="mc-desc">
                            Fuites (HIBP), comptes tiers (Holehe), profil Google
                            et Gravatar.
                        </p>
                        <ul class="mc-tags" aria-label="Services utilisés">
                            <li>HIBP</li><li>Holehe</li><li>Gravatar</li><li>
                                Google
                            </li>
                        </ul>
                    </article>

                    <article class="module-card mc-ip">
                        <div class="mc-icon" aria-hidden="true">⬡</div>
                        <h3 class="mc-name">Adresse IP</h3>
                        <p class="mc-desc">
                            Géolocalisation, ASN, scan historique Shodan,
                            blacklists.
                        </p>
                        <ul class="mc-tags" aria-label="Services utilisés">
                            <li>ip-api</li><li>Shodan</li><li>Censys</li><li>
                                AbuseIPDB
                            </li>
                        </ul>
                    </article>

                    <article class="module-card mc-user">
                        <div class="mc-icon" aria-hidden="true">@</div>
                        <h3 class="mc-name">Username</h3>
                        <p class="mc-desc">
                            Détection de présence sur +500 plateformes, dorks
                            Google ciblés.
                        </p>
                        <ul class="mc-tags" aria-label="Services utilisés">
                            <li>Sherlock</li><li>WhatsMyName</li><li>Dorks</li>
                        </ul>
                    </article>

                    <article class="module-card mc-discord">
                        <div class="mc-icon" aria-hidden="true">#</div>
                        <h3 class="mc-name">Discord ID</h3>
                        <p class="mc-desc">
                            Décodage Snowflake, avatar, bannière, historique de
                            pseudos.
                        </p>
                        <ul class="mc-tags" aria-label="Services utilisés">
                            <li>Snowflake</li><li>DiscordLookup</li>
                        </ul>
                    </article>

                    <article class="module-card mc-address">
                        <div class="mc-icon" aria-hidden="true">◈</div>
                        <h3 class="mc-name">Adresse</h3>
                        <p class="mc-desc">
                            Cartographie OSM, dorks voisinage, entreprises
                            locales.
                        </p>
                        <ul class="mc-tags" aria-label="Services utilisés">
                            <li>OpenStreetMap</li><li>Nominatim</li><li>
                                Dorks
                            </li>
                        </ul>
                    </article>

                    <article class="module-card mc-google">
                        <div class="mc-icon" aria-hidden="true">🔍</div>
                        <h3 class="mc-name">Google Scraper</h3>
                        <p class="mc-desc">
                            Extraction automatisée des résultats de recherche,
                            indexation des titres, snippets et liens cibles via
                            proxy rotation.
                        </p>
                        <ul class="mc-tags" aria-label="Services utilisés">
                            <li>SERP-API</li>
                            <li>Google Search</li>
                            <li>Puppeteer</li>
                            <li>Proxy Rotation</li>
                        </ul>
                    </article>

                    <article class="module-card mc-dns">
                        <div class="mc-icon" aria-hidden="true">🌐</div>
                        <h3 class="mc-name">Reconnaissance DNS</h3>
                        <p class="mc-desc">
                            Analyse exhaustive des enregistrements, découverte
                            de sous-domaines et résolution récursive des zones
                            sensibles.
                        </p>
                        <ul class="mc-tags" aria-label="Services utilisés">
                            <li>Cloudflare</li>
                            <li>VirusTotal</li>
                            <li>Dig</li>
                            <li>Subfinder</li>
                        </ul>
                    </article>
                </div>
            </section>

            <section class="pricing-section" id="tarifs">
                <!-- Optionnel : Titre de section pour structurer -->
                <span class="section-eyebrow">// Tarifs</span>
                <h2 class="section-title">
                    Des plans adaptés à vos besoins de surveillance
                </h2>

                <div class="pricing-grid">
                    <!-- Diagnostic (Gratuit) -->
                    <div class="price-card">
                        <span class="pc-tier">Diagnostic</span>
                        <div class="pc-price">0€ <span>/ mois</span></div>
                        <p class="pc-desc">
                            Pour vérifier votre propre exposition aux fuites de
                            données.
                        </p>
                        <ul class="pc-features">
                            <li>1 crédit / 2 jours</li>
                            <li>Auto-recherche uniquement</li>
                            <li>Validation d'identité requise</li>
                            <li>Accès communauté Discord</li>
                        </ul>
                        <button class="btn-ghost pc-btn">Commencer</button>
                    </div>

                    <!-- Starter -->
                    <div class="price-card">
                        <span class="pc-tier">Starter</span>
                        <div class="pc-price">7,99€ <span>/ mois</span></div>
                        <p class="pc-desc">
                            Veille personnelle de base et alertes de sécurité.
                        </p>
                        <ul class="pc-features">
                            <li><strong>240 crédits</strong> / mois</li>
                            <li>35 sources de données</li>
                            <li>Transfert de crédits (P2P)</li>
                            <li>Historique personnel</li>
                        </ul>
                        <button class="btn-ghost pc-btn">S'abonner</button>
                    </div>

                    <!-- Expert (Recommandé) -->
                    <div class="price-card featured">
                        <span class="pc-tier">Expert</span>
                        <div class="pc-price">39,99€ <span>/ mois</span></div>
                        <p class="pc-desc">
                            Pour les analystes de menaces et experts cyber.
                        </p>
                        <ul class="pc-features">
                            <li><strong>2 000 crédits</strong> / mois</li>
                            <li>72+ sources de données</li>
                            <li>ReconAI (Analyse IA)</li>
                            <li>Exports CSV et PDF</li>
                            <li>Support prioritaire</li>
                        </ul>
                        <button class="btn-primary pc-btn"
                            >Choisir Expert</button
                        >
                    </div>

                    <!-- Lifetime Pro -->
                    <div class="price-card">
                        <span class="pc-tier">Lifetime Pro</span>
                        <div class="pc-price">150€ <span>/ à vie</span></div>
                        <p class="pc-desc">
                            Aucun abonnement, un accès privilégié à vie.
                        </p>
                        <ul class="pc-features">
                            <li><strong>16 000 crédits</strong> inclus</li>
                            <li>Toutes les fonctions débloquées</li>
                            <li>SLA Routing (Requêtes ultra-rapides)</li>
                            <li>Support VIP Discord</li>
                            <li>Mises à jour incluses</li>
                        </ul>
                        <button class="btn-ghost pc-btn"
                            >Obtenir mon accès</button
                        >
                    </div>
                </div>
            </section>

            <section
                class="modules-section"
                id="docs"
                style="border-top: 1px solid var(--border); padding-top: 60px;"
            >
                <div class="section-eyebrow">// DOCUMENTATION</div>
                <h2 class="section-title">
                    Outil <span class="title-accent">SpyderOSINT</span>
                </h2>

                <p
                    class="hero-sub"
                    style="margin: 0 0 40px 0; text-align: left; max-width: 600px;"
                >
                    Un crawler web asynchrone ultra-rapide conçu pour indexer,
                    parser et extraire les données du web avec une consommation
                    de ressources minimale.
                </p>

                <div
                    class="modules-grid"
                    style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));"
                >
                    <!-- Carte 1 : Installation -->
                    <div class="module-card">
                        <i class="mc-icon">⚡</i>
                        <h3 class="mc-name">Installation</h3>
                        <p class="mc-desc">
                            Aucune installation n'est requise pour débuter :
                            notre solution est entièrement préconfigurée au sein
                            de la webapp, vous permettant de déployer vos outils
                            et de lancer vos premières analyses instantanément,
                            sans aucune gestion d'infrastructure ou de
                            dépendance locale.
                        </p>
                    </div>

                    <!-- Carte 2 : Usage Basique -->
                    <div class="module-card">
                        <i class="mc-icon">⚙️</i>
                        <h3 class="mc-name">Démarrage Rapide</h3>
                        <p class="mc-desc">
                            Configure une instance, définis l'action au
                            chargement d'une page et lance le crawl.
                        </p>
                    </div>

                    <!-- Carte 3 : Options de Configuration -->
                    <div class="module-card">
                        <i class="mc-icon">🛠️</i>
                        <h3 class="mc-name">Options Clés</h3>
                        <p class="mc-desc">
                            Tirez parti de notre système de tags intégrés pour
                            effectuer une recherche approfondie, affiner vos
                            résultats selon vos besoins spécifiques et
                            personnaliser votre exploration de la documentation.
                        </p>
                        <ul
                            style="list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 12px; color: var(--gray-6);"
                        >
                            <li>
                                <code style="color: var(--white);"
                                    >L'IPv4 (IP)</code
                                > — 192.168.1.1
                            </li>
                            <li>
                                <code style="color: var(--white);">L'email</code
                                > — JhonDoe@example.com
                            </li>
                            <li>
                                <code style="color: var(--white);"
                                    >Resaux sociaux</code
                                > — nom d'utilisateur du compte ou identifiant d'utilisateur.
                            </li>
                            <li>
                                <code style="color: var(--white);"
                                    >IA a venir</code
                                > — SpyderIA arrive bientot !
                            </li>
                        </ul>
                    </div>
                </div>
            </section>
        </main>

        <!-- ════════════════════════════════════════════
       FOOTER
  ════════════════════════════════════════════ -->
        <footer class="footer">
            <div class="footer-left">
                <span class="logo-wordmark" style="font-size:13px"
                    >SPYDER<em>OSINT</em></span
                >
                <span class="footer-copy"
                    >Usage éthique et légal uniquement.</span
                >
            </div>
            <div class="footer-right">
                <a href="/docs">Docs</a>
                <a href="/legal">Mentions légales</a>
                <a href="https://github.com" target="_blank" rel="noopener"
                    >GitHub</a
                >
            </div>
        </footer>
    </body>
</html>

<!-- ════════════════════════════════════════════
     STYLES
════════════════════════════════════════════ -->
<style is:global>
    /* ── Reset & Tokens ── */
    *,
    *::before,
    *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        /* Tokens Monochrome & Cyber-Minimalist */
        --accent: #ffffff;
        --accent-hover: #e0e0e0;
        --yellow: var(
            --accent
        ); /* Alias pour compatibilité avec le HTML existant */

        --black: #030303;
        --white: #ffffff;

        --gray-1: #0a0a0a;
        --gray-2: #101010;
        --gray-3: #161616;
        --gray-4: #222222;
        --gray-5: #555555;
        --gray-6: #888888;

        --border: rgba(255, 255, 255, 0.07);
        --border-s: rgba(255, 255, 255, 0.14);

        --dot: "Share Tech Mono", monospace;
        --sans: "Space Grotesk", system-ui, sans-serif;
        --radius: 8px;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: var(--sans);
        background: var(--black);
        color: var(--white);
        min-height: 100vh;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }

    /* ── Glow curseur (Lueur blanche subtile) ── */
    #cursor-glow {
        pointer-events: none;
        position: fixed;
        width: 650px;
        height: 650px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(255, 255, 255, 0.04) 0%,
            transparent 65%
        );
        transform: translate(-50%, -50%);
        top: 50%;
        left: 50%;
        z-index: 0;
        will-change: top, left;
        transition:
            top 0.05s linear,
            left 0.05s linear;
    }

    /* ── Grille de fond (Grid technique sombre) ── */
    .bg-grid {
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.02) 1px,
                transparent 1px
            );
        background-size: 50px 50px;
        z-index: 0;
        pointer-events: none;
    }

    /* ── Navbar ── */
    .navbar {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 32px;
        padding: 0 40px;
        height: 64px;
        border-bottom: 1px solid var(--border);
        background: rgba(3, 3, 3, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    .nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        flex-shrink: 0;
    }

    img {
        width: 50px;
        height: 50px;
        filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.2));
    }

    .logo-wordmark {
