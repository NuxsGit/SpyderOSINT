---
// Aucune prop — ce composant est autonome
---

<div class="search-zone">
    <p class="search-eyebrow">// email · ip · discord · username · adresse</p>

    <div class="search-box">
        <input
            id="search-input"
            type="text"
            placeholder="john.doe@gmail.com  /  192.168.1.1  /  @pseudo"
            autocomplete="off"
        />
        <button id="search-btn">SCAN ▶</button>
    </div>

    <p id="search-feedback" class="feedback" aria-live="polite"></p>
</div>

<script>
    const input = document.getElementById("search-input") as HTMLInputElement;
    const btn = document.getElementById("search-btn") as HTMLButtonElement;
    const fb = document.getElementById(
        "search-feedback",
    ) as HTMLParagraphElement;

    btn.addEventListener("click", async () => {
        const query = input.value.trim();
        if (!query) return;

        btn.disabled = true;
        btn.textContent = "ANALYSE…";
        fb.textContent = "";

        try {
            const res = await fetch("/api/search", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ query }),
            });
            const data = await res.json();

            if (!res.ok) {
                fb.textContent = data.error ?? "Erreur inconnue.";
                return;
            }

            // Redirige vers la page de résultats avec le type détecté
            const params = new URLSearchParams({
                q: query,
                type: data.type,
                stream: data.streamUrl,
            });
            window.location.href = `/results/${encodeURIComponent(query)}?${params}`;
        } catch (e) {
            fb.textContent = "Impossible de contacter le serveur.";
        } finally {
            btn.disabled = false;
            btn.textContent = "SCAN ▶";
        }
    });

    // Touche Entrée
    input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") btn.click();
    });
</script>
